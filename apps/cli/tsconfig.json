{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@foxschema/sql": ["../../packages/sql/src/index.ts"],
      "@foxschema/db": ["../../packages/db/src/index.ts"],
      "@foxschema/db/mail": ["../../packages/db/src/mail/smtp.ts"],
      "@foxschema/shared": ["../../packages/shared/src/index.ts"],
      "@foxschema/server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src"]
}
