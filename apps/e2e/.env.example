# Copy to apps/e2e/.env (gitignored). Matches docker-compose.yml Postgres.
E2E_BASE_URL=http://127.0.0.1:5173

# The Fox account the browser suites sign in as. Every install requires sign-in;
# on a fresh dev database the suites create this admin through first-run setup
# (on the API port directly, so no setup code is needed). If you already set up
# this dev instance by hand, put an admin account of yours here instead.
E2E_APP_EMAIL=e2e-admin@foxschema.test
E2E_APP_PASSWORD=e2e-3e2cf9bc8f9dc5d661
# The API itself, for setup and sign-in (not through the Vite proxy).
E2E_API_URL=http://127.0.0.1:3210
E2E_POSTGRES_SOURCE_HOST=127.0.0.1
E2E_POSTGRES_SOURCE_PORT=5432
E2E_POSTGRES_SOURCE_DB=foxdb
E2E_POSTGRES_SOURCE_USER=foxuser
E2E_POSTGRES_SOURCE_PASS=foxpass
E2E_POSTGRES_SOURCE_SCHEMA=demo_a
E2E_POSTGRES_TARGET_HOST=127.0.0.1
E2E_POSTGRES_TARGET_PORT=5432
E2E_POSTGRES_TARGET_DB=foxdb
E2E_POSTGRES_TARGET_USER=foxuser
E2E_POSTGRES_TARGET_PASS=foxpass
E2E_POSTGRES_TARGET_SCHEMA=demo_b

# Optional extra dialects (see docker-compose.yml + scripts/seed/seed-all.sh):
# ClickHouse  :8123  default/foxpass   db=demo_a vs demo_b
# TiDB        :4000  foxuser/foxpass      db=demo_a vs demo_b
# Redshift*   :5439  foxuser/foxpass   db=foxdb schema=demo_a vs demo_b  (*Postgres stand-in)
# DuckDB      /tmp/foxschema-duckdb/demo_{a,b}.duckdb

# --- ClickHouse (db=demo_a vs demo_b, HTTP port) ---
E2E_CLICKHOUSE_SOURCE_HOST=127.0.0.1
E2E_CLICKHOUSE_SOURCE_PORT=8123
E2E_CLICKHOUSE_SOURCE_DB=demo_a
E2E_CLICKHOUSE_SOURCE_USER=default
E2E_CLICKHOUSE_SOURCE_PASS=foxpass
# ClickHouse reports schemaRequired, so the Utilities screens (Clone Table,
# Index Management) refuse to browse until one is picked — the same prompt a
# user gets in the app. Without these the suite fails with "no customers table"
# and nothing explains why, because the database alone looks sufficient.
E2E_CLICKHOUSE_SOURCE_SCHEMA=demo_a
E2E_CLICKHOUSE_TARGET_HOST=127.0.0.1
E2E_CLICKHOUSE_TARGET_PORT=8123
E2E_CLICKHOUSE_TARGET_DB=demo_b
E2E_CLICKHOUSE_TARGET_USER=default
E2E_CLICKHOUSE_TARGET_PASS=foxpass
E2E_CLICKHOUSE_TARGET_SCHEMA=demo_b

# --- TiDB (MySQL protocol; db=demo_a vs demo_b) ---
E2E_TIDB_SOURCE_HOST=127.0.0.1
E2E_TIDB_SOURCE_PORT=4000
E2E_TIDB_SOURCE_DB=demo_a
E2E_TIDB_SOURCE_USER=foxuser
E2E_TIDB_SOURCE_PASS=foxpass
E2E_TIDB_TARGET_HOST=127.0.0.1
E2E_TIDB_TARGET_PORT=4000
E2E_TIDB_TARGET_DB=demo_b
E2E_TIDB_TARGET_USER=foxuser
E2E_TIDB_TARGET_PASS=foxpass

# --- Redshift stand-in (Postgres 16 on 5439; schema=demo_a vs demo_b) ---
E2E_REDSHIFT_SOURCE_HOST=127.0.0.1
E2E_REDSHIFT_SOURCE_PORT=5439
E2E_REDSHIFT_SOURCE_DB=foxdb
E2E_REDSHIFT_SOURCE_USER=foxuser
E2E_REDSHIFT_SOURCE_PASS=foxpass
E2E_REDSHIFT_SOURCE_SCHEMA=demo_a
E2E_REDSHIFT_TARGET_HOST=127.0.0.1
E2E_REDSHIFT_TARGET_PORT=5439
E2E_REDSHIFT_TARGET_DB=foxdb
E2E_REDSHIFT_TARGET_USER=foxuser
E2E_REDSHIFT_TARGET_PASS=foxpass
E2E_REDSHIFT_TARGET_SCHEMA=demo_b

# --- DuckDB (file databases; host/user unused but required by readConfig) ---
E2E_DUCKDB_SOURCE_HOST=localhost
E2E_DUCKDB_SOURCE_DB=/tmp/foxschema-duckdb/demo_a.duckdb
E2E_DUCKDB_SOURCE_USER=duckdb
E2E_DUCKDB_SOURCE_PASS=
E2E_DUCKDB_TARGET_HOST=localhost
E2E_DUCKDB_TARGET_DB=/tmp/foxschema-duckdb/demo_b.duckdb
E2E_DUCKDB_TARGET_USER=duckdb
E2E_DUCKDB_TARGET_PASS=
