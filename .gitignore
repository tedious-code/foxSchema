.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
foxschema.db*
schemacompare.db*

# Personal working notes stay on this machine. Everything else in Markdown is
# tracked: a blanket `*.md` rule here used to swallow real docs silently (the
# dialect checklist, an example guide) until someone noticed a link was dead.
IMPLEMENTATION_STATE.md
docs/IMPLEMENTATION_HISTORY.md
CLAUDE.md
CHANGELOG.md

docs/demo/*
!docs/demo/foxschema-demo.mp4
!docs/demo/foxschema-demo.gif
!docs/demo/cross-dialect-sqlite-postgres.gif
!docs/demo/sql-editor.gif
!docs/demo/sql-editor.png

# Local environment / secrets (keep .env.example tracked)
.env
.env.local
.env.*.local

# CLI build output
apps/cli/dist/
apps/cli/dist-bin/
apps/cli/ui-dist/
apps/cli/npm-pack/
packages/sql/npm-pack/
packages/db/npm-pack/

# Turborepo task cache. Local only — remote caching is not configured.
.turbo/

# Homebrew formula docs (tracked)
!packaging/homebrew/README.md
!apps/cli/README.md
!docs/homebrew.md


# The workflow engine's SQLite DB, created at the repo root by default
# (packages/workflow-engine/src/storage/database-path.ts). Its credentials and
# variables tables can hold real secrets, so it never belongs in the repo.
workflow-engine.sqlite
workflow-engine.sqlite-shm
workflow-engine.sqlite-wal
workflow-files/
# Left by the FoxAgent engine before it moved here.
foxflow.sqlite
foxflow.sqlite-shm
foxflow.sqlite-wal
