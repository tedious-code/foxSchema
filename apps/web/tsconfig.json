{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/frontend/*"],
      "@foxschema/sql": ["../../packages/sql/src/index.ts"],
      "@foxschema/db": ["../../packages/db/src/index.ts"],
      "@foxschema/db/mail": ["../../packages/db/src/mail/smtp.ts"],
      "@foxschema/shared": ["../../packages/shared/src/index.ts"],
      "@foxschema/ui-shared": ["../../packages/ui-shared/src/index.ts"],
      "@foxschema/server": ["../../packages/server/src/index.ts"]
    }
  },
  "include": ["src", "../../packages", "../workflow-server/src"]
}
