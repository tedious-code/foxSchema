{
  "name": "@foxschema/cli",
  "version": "0.2.307",
  "private": true,
  "type": "module",
  "description": "Fox Schema CLI — schema diff, migrations, and a rich SQL Editor (TypeScript / Node ESM)",
  "license": "Apache-2.0",
  "bin": {
    "foxschema": "dist/index.js",
    "fox": "dist/index.js"
  },
  "files": [
    "dist",
    "ui-dist",
    "resources",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "fox": "tsx src/index.ts",
    "foxschema": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node build.mjs",
    "build:binary": "node build-binary.mjs",
    "prepare-publish": "node scripts/prepare-publish.mjs"
  },
  "dependencies": {
    "@foxschema/db": "*",
    "@foxschema/server": "*",
    "@foxschema/shared": "*",
    "@foxschema/sql": "*",
    "@foxschema/web": "*",
    "@inquirer/prompts": "8.7.2",
    "@napi-rs/keyring": "2.1.0",
    "chalk": "6.0.1",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "ink": "7.1.1",
    "ink-select-input": "6.2.0",
    "ink-spinner": "5.0.0",
    "ink-text-input": "6.0.0",
    "react": "19.3.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "ink-testing-library": "4.0.0",
    "postject": "1.0.0-alpha.6"
  },
  "author": "Huy Phan <huyplb@gmail.com>",
  "homepage": "https://foxschema.com",
  "bugs": "https://github.com/tedious-code/foxschema/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tedious-code/foxschema.git"
  },
  "keywords": [
    "foxschema",
    "sql",
    "sql-editor",
    "schema",
    "migration",
    "typescript",
    "esm",
    "database"
  ]
}
